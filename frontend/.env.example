// ============================================================
// Academix AI — Environment Variables (.env.example)
// Copy this to .env and fill in your values
// ============================================================

# Supabase (Frontend SDK uses anon key only — safe to expose)
# Get from: Supabase Dashboard → Settings → API
# TODO: Set your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# TODO: Set your Supabase anon/public key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL. Either the bare backend origin or with /api — "/api" is
# appended automatically if missing. Leave empty in dev to use the Vite proxy.
# On Railway set it to the backend service URL (it is baked in at build time,
# so redeploy the frontend after changing it), e.g.
#   VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=http://localhost:8000
