// ============================================================
// Academix AI — Environment Variables (.env.example)
// Copy this to .env and fill in your values
// ============================================================

# Supabase (Frontend SDK uses anon key only — safe to expose)
# Get from: Supabase Dashboard → Settings → API
# TODO: Set your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# TODO: Set your Supabase anon/public key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL (proxied via Vite in dev, set to production URL in prod)
VITE_API_URL=http://localhost:8000
